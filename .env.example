# Optional: Arc mainnet RPC(s) the local server proxies for the page (comma-separated). Keys stay on the server; the page only
# sees hostnames. Default: https://rpc.arc-scan.org (public, slow, rate-limited).
ARC_RPC_URLS=

# Optional: lets the local server pin images to Pinata (pinata.cloud → API Keys). Either a JWT or key + secret.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# Server bind (defaults shown). Keep HOST on 127.0.0.1 unless you trust the network.
PORT=8788
HOST=127.0.0.1
